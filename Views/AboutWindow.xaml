<Window x:Class="RemouteAddressBook.Views.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="О приложении"
        Width="460"
        SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI"
        FontSize="13"
        Icon="/Assets/app.ico"
        Background="{DynamicResource WindowBackgroundBrush}">

    <StackPanel Margin="20">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Image Source="/Assets/app.png"
                   Width="72"
                   Height="72"
                   VerticalAlignment="Top"
                   RenderOptions.BitmapScalingMode="HighQuality" />

            <StackPanel Grid.Column="1" Margin="16,4,0,0">
                <TextBlock Text="Remoute — Address Book"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextBrush}" />
                <TextBlock x:Name="VersionText"
                           Margin="0,2,0,0"
                           Foreground="{DynamicResource MutedTextBrush}" />
                <TextBlock Margin="0,10,0,0"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource TextBrush}"
                           Text="Адресная книга для запуска сессий удалённого доступа: AnyDesk, Rudesktop, Ассистент, AmmyyAdmin, RDP." />
            </StackPanel>
        </Grid>

        <Border Height="1" Margin="0,16" Background="{DynamicResource BorderBrushLight}" />

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="6" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="6" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="База данных" Style="{StaticResource FieldLabelStyle}" />
            <TextBox x:Name="DatabasePathBox"
                     Grid.Row="0"
                     Grid.Column="1"
                     IsReadOnly="True" />
            <Button Grid.Row="0"
                    Grid.Column="2"
                    Style="{StaticResource IconButtonStyle}"
                    Content="&#xE838;"
                    ToolTip="Открыть папку"
                    Margin="4,0,0,0"
                    Click="OpenDatabaseFolder_Click" />

            <TextBlock Grid.Row="2" Text="Настройки" Style="{StaticResource FieldLabelStyle}" />
            <TextBox x:Name="SettingsPathBox"
                     Grid.Row="2"
                     Grid.Column="1"
                     IsReadOnly="True" />
            <Button Grid.Row="2"
                    Grid.Column="2"
                    Style="{StaticResource IconButtonStyle}"
                    Content="&#xE838;"
                    ToolTip="Открыть папку"
                    Margin="4,0,0,0"
                    Click="OpenSettingsFolder_Click" />

            <TextBlock Grid.Row="4" Text="Платформа" Style="{StaticResource FieldLabelStyle}" />
            <TextBlock x:Name="RuntimeText"
                       Grid.Row="4"
                       Grid.Column="1"
                       Grid.ColumnSpan="2"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource MutedTextBrush}" />
        </Grid>

        <Button Content="Закрыть"
                Style="{StaticResource FlatButtonStyle}"
                HorizontalAlignment="Right"
                Margin="0,18,0,0"
                IsDefault="True"
                IsCancel="True" />
    </StackPanel>
</Window>
