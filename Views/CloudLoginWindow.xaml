<Window x:Class="RemoteAccessAddressBook.Views.CloudLoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Облачная база — вход"
        Width="460"
        SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI"
        FontSize="13"
        Icon="/Assets/app.ico"
        Background="{DynamicResource WindowBackgroundBrush}">

    <StackPanel Margin="16">
        <TextBlock TextWrapping="Wrap"
                   Margin="0,0,0,12"
                   Foreground="{DynamicResource TextBrush}"
                   Text="Адрес сервера, логин и пароль выдаёт администратор. Пароль не сохраняется: программа получает и хранит только ключ доступа." />

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="110" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Сервер" Style="{StaticResource FieldLabelStyle}" Margin="0,5,8,5" />
            <TextBox x:Name="ServerBox" Grid.Row="0" Grid.Column="1" Margin="0,5" ToolTip="Например: addr.example.com или https://addr.example.com" />

            <TextBlock Grid.Row="1" Text="Логин" Style="{StaticResource FieldLabelStyle}" Margin="0,5,8,5" />
            <TextBox x:Name="LoginBox" Grid.Row="1" Grid.Column="1" Margin="0,5" />

            <TextBlock Grid.Row="2" Text="Пароль" Style="{StaticResource FieldLabelStyle}" Margin="0,5,8,5" />
            <PasswordBox x:Name="PasswordInput" Grid.Row="2" Grid.Column="1" Margin="0,5" />
        </Grid>

        <TextBlock x:Name="ErrorText"
                   Margin="0,10,0,0"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource DangerBrush}"
                   Visibility="Collapsed" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="LoginButton"
                    Content="Войти"
                    Style="{StaticResource FlatButtonStyle}"
                    IsDefault="True"
                    Click="Login_Click"
                    Margin="0,0,8,0" />
            <Button Content="Отмена"
                    Style="{StaticResource SecondaryButtonStyle}"
                    IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>
