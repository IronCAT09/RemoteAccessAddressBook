<Window x:Class="RemoteAccessAddressBook.Views.ConflictWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Расхождение"
        Width="720"
        SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI"
        FontSize="13"
        Icon="/Assets/app.ico"
        Background="{DynamicResource WindowBackgroundBrush}">

    <StackPanel Margin="16">
        <TextBlock x:Name="MessageText" TextWrapping="Wrap" Margin="0,0,0,12" Foreground="{DynamicResource TextBrush}" />

        <Border BorderBrush="{DynamicResource BorderBrushLight}" BorderThickness="1">
            <Grid x:Name="CompareGrid">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
            </Grid>
        </Border>

        <TextBlock Margin="0,6,0,0"
                   FontSize="12"
                   Foreground="{DynamicResource MutedTextBrush}"
                   Text="Различающиеся поля выделены." />

        <CheckBox x:Name="ApplyToAllCheckBox"
                  Margin="0,12,0,0"
                  Content="Применить этот выбор ко всем остальным расхождениям"
                  Visibility="Collapsed" />

        <WrapPanel HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="LeftButton" Style="{StaticResource FlatButtonStyle}" Click="Left_Click" Margin="0,0,8,0" />
            <Button x:Name="RightButton" Style="{StaticResource SecondaryButtonStyle}" Click="Right_Click" Margin="0,0,8,0" />
            <Button x:Name="BothButton" Style="{StaticResource SecondaryButtonStyle}" Click="Both_Click" Margin="0,0,8,0" />
            <Button Content="Отмена" Style="{StaticResource SecondaryButtonStyle}" IsCancel="True" />
        </WrapPanel>
    </StackPanel>
</Window>
