<Window x:Class="RemoteAccessAddressBook.Views.ContactEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Контакт"
        Width="560"
        Height="620"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        FontFamily="Segoe UI"
        FontSize="13"
        Background="{DynamicResource WindowBackgroundBrush}">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="130" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="Имя" Style="{StaticResource FieldLabelStyle}" Margin="0,6,8,6" />
            <TextBox x:Name="NameBox" Grid.Row="0" Grid.Column="1" Style="{StaticResource InputTextBoxStyle}" Margin="0,6" />

            <TextBlock Grid.Row="1" Grid.Column="0" Text="Комментарий" Style="{StaticResource FieldLabelStyle}" Margin="0,6,8,6" />
            <TextBox x:Name="CommentBox" Grid.Row="1" Grid.Column="1" Style="{StaticResource InputTextBoxStyle}" Margin="0,6" />

            <TextBlock Grid.Row="2" Grid.Column="0" Text="AnyDesk" Style="{StaticResource FieldLabelStyle}" Margin="0,6,8,6" />
            <TextBox x:Name="AnyDeskBox" Grid.Row="2" Grid.Column="1" Style="{StaticResource InputTextBoxStyle}" Margin="0,6" />

            <TextBlock Grid.Row="3" Grid.Column="0" Text="Rudesktop" Style="{StaticResource FieldLabelStyle}" Margin="0,6,8,6" />
            <TextBox x:Name="RudesktopBox" Grid.Row="3" Grid.Column="1" Style="{StaticResource InputTextBoxStyle}" Margin="0,6" />

            <TextBlock Grid.Row="4" Grid.Column="0" Text="Ассистент" Style="{StaticResource FieldLabelStyle}" Margin="0,6,8,6" />
            <TextBox x:Name="AssistantBox" Grid.Row="4" Grid.Column="1" Style="{StaticResource InputTextBoxStyle}" Margin="0,6" />

            <TextBlock Grid.Row="5" Grid.Column="0" Text="AmmyyAdmin" Style="{StaticResource FieldLabelStyle}" Margin="0,6,8,6" />
            <TextBox x:Name="AmmyyBox" Grid.Row="5" Grid.Column="1" Style="{StaticResource InputTextBoxStyle}" Margin="0,6" />

            <TextBlock Grid.Row="6" Grid.Column="0" Text="Пароль" Style="{StaticResource FieldLabelStyle}" Margin="0,6,8,6" />
            <TextBox x:Name="PasswordBox" Grid.Row="6" Grid.Column="1" Style="{StaticResource InputTextBoxStyle}" Margin="0,6" />

            <TextBlock Grid.Row="7" Grid.Column="0" Text="RDP" Style="{StaticResource FieldLabelStyle}" Margin="0,6,8,6" />
            <TextBox x:Name="RdpBox" Grid.Row="7" Grid.Column="1" Style="{StaticResource InputTextBoxStyle}" Margin="0,6" />

            <TextBlock Grid.Row="8" Grid.Column="0" Text="RDP Логин" Style="{StaticResource FieldLabelStyle}" Margin="0,6,8,6" />
            <TextBox x:Name="RdpLoginBox" Grid.Row="8" Grid.Column="1" Style="{StaticResource InputTextBoxStyle}" Margin="0,6" />

            <TextBlock Grid.Row="9" Grid.Column="0" Text="RDP Пароль" Style="{StaticResource FieldLabelStyle}" Margin="0,6,8,6" />
            <TextBox x:Name="RdpPasswordBox" Grid.Row="9" Grid.Column="1" Style="{StaticResource InputTextBoxStyle}" Margin="0,6" />

            <TextBlock Grid.Row="10" Grid.Column="0" Text="Группа" Style="{StaticResource FieldLabelStyle}" Margin="0,6,8,6" />
            <ComboBox x:Name="GroupComboBox"
                      Grid.Row="10"
                      Grid.Column="1"
                      Margin="0,6"
                      MinHeight="26"
                      ItemTemplate="{StaticResource NameItemTemplate}" />
        </Grid>

        <GroupBox Grid.Row="1" Header="Метки" Margin="0,12,0,0" BorderBrush="{DynamicResource BorderBrushLight}">
            <ListBox x:Name="LabelsList" BorderThickness="0" Margin="4">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <CheckBox Content="{Binding Name}" IsChecked="{Binding IsChecked, Mode=TwoWay}" Margin="2" />
                    </DataTemplate>
                </ListBox.ItemTemplate>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Focusable" Value="False" />
                        <Setter Property="Padding" Value="2" />
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>
        </GroupBox>

        <Grid Grid.Row="2" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Новый контакт: куда сохранить. Существующий: где он хранится. -->
            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <CheckBox x:Name="SaveToCloudCheckBox"
                          Content="Сохранить в облачную базу"
                          Visibility="Collapsed" />
                <TextBlock x:Name="CloudNoteText"
                           Margin="20,2,0,0"
                           FontSize="12"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource MutedTextBrush}"
                           Visibility="Collapsed" />
                <TextBlock x:Name="SourceText"
                           Foreground="{DynamicResource MutedTextBrush}"
                           Visibility="Collapsed" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="Сохранить"
                        Style="{StaticResource FlatButtonStyle}"
                        IsDefault="True"
                        Click="Save_Click"
                        Margin="0,0,8,0" />
                <Button Content="Отмена"
                        Style="{StaticResource SecondaryButtonStyle}"
                        IsCancel="True"
                        Click="Cancel_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
