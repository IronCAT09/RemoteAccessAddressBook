<Window x:Class="RemoteAccessAddressBook.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:conv="clr-namespace:RemoteAccessAddressBook.Converters"
        Title="Remote Access — Address Book"
        Width="1220"
        Height="640"
        MinWidth="900"
        MinHeight="480"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackgroundBrush}"
        FontFamily="Segoe UI"
        FontSize="13"
        Foreground="{DynamicResource TextBrush}"
        Icon="/Assets/app.ico"
        WindowStyle="None"
        AllowsTransparency="False">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            ResizeBorderThickness="6"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <conv:NullToVisibilityConverter x:Key="NullToVisibility" />
    </Window.Resources>

    <Border x:Name="RootBorder"
            BorderBrush="{DynamicResource AccentBrush}"
            BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="34" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Кастомный заголовок окна -->
            <Grid Grid.Row="0"
                  Background="{DynamicResource PanelBackgroundBrush}"
                  MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="10,0,0,0" VerticalAlignment="Center">
                    <Image Source="/Assets/app.png"
                           Width="22"
                           Height="22"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Text="Remote Access — Address Book"
                               Margin="8,0,0,0"
                               VerticalAlignment="Center"
                               FontWeight="SemiBold" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource IconButtonStyle}"
                            Command="{Binding ToggleThemeCommand}"
                            Content="{Binding ThemeGlyph}"
                            ToolTip="{Binding ThemeToolTip}" />
                    <Button Style="{StaticResource IconButtonStyle}"
                            Command="{Binding OpenSettingsCommand}"
                            Content="&#xE713;"
                            ToolTip="Настройки" />
                    <Button Style="{StaticResource IconButtonStyle}"
                            Command="{Binding ImportCommand}"
                            Content="&#xE8B5;"
                            ToolTip="Импорт контактов из CSV/XLSX" />
                    <Button Style="{StaticResource IconButtonStyle}"
                            Command="{Binding AboutCommand}"
                            Content="&#xE946;"
                            ToolTip="О приложении" />
                    <TextBlock Text="{Binding Version}"
                               Margin="10,0,10,0"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource MutedTextBrush}" />
                    <Button x:Name="MinimizeButton"
                            Style="{StaticResource CaptionButtonStyle}"
                            Click="MinimizeButton_Click"
                            Content="&#xE921;"
                            ToolTip="Свернуть" />
                    <Button x:Name="MaximizeButton"
                            Style="{StaticResource CaptionButtonStyle}"
                            Click="MaximizeButton_Click"
                            Content="&#xE922;"
                            ToolTip="Развернуть" />
                    <Button Style="{StaticResource CloseButtonStyle}"
                            Click="CloseButton_Click"
                            Content="&#xE8BB;"
                            ToolTip="Закрыть" />
                </StackPanel>
            </Grid>

            <!-- Основная область -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Панель меток -->
                <Border Grid.Column="0"
                        Width="180"
                        Background="{DynamicResource PanelBackgroundBrush}"
                        BorderBrush="{DynamicResource BorderBrushLight}"
                        BorderThickness="0,1,1,0"
                        Visibility="{Binding ShowLabelsPanel, Converter={StaticResource BoolToVisibility}}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="34" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <TextBlock Text="Метки" Style="{StaticResource PanelHeaderTextStyle}" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,4,0">
                                <Button Style="{StaticResource IconButtonStyle}"
                                        Command="{Binding ClearLabelFilterCommand}"
                                        Content="&#xE894;"
                                        ToolTip="Сбросить фильтр по метке" />
                                <Button Style="{StaticResource IconButtonStyle}"
                                        Command="{Binding AddLabelCommand}"
                                        Content="&#xE710;"
                                        ToolTip="Добавить метку" />
                                <Button Style="{StaticResource IconButtonStyle}"
                                        Command="{Binding EditLabelCommand}"
                                        Content="&#xE70F;"
                                        ToolTip="Переименовать метку" />
                                <Button Style="{StaticResource IconButtonStyle}"
                                        Command="{Binding DeleteLabelCommand}"
                                        Content="&#xE74D;"
                                        ToolTip="Удалить метку" />
                            </StackPanel>
                        </Grid>

                        <ListBox Grid.Row="1"
                                 Style="{StaticResource SidebarListBoxStyle}"
                                 ItemsSource="{Binding Labels}"
                                 SelectedItem="{Binding SelectedLabel, Mode=TwoWay}"
                                 DisplayMemberPath="Name"
                                 Margin="4" />
                    </Grid>
                </Border>

                <!-- Панель групп -->
                <Border Grid.Column="1"
                        Width="210"
                        Background="{DynamicResource PanelBackgroundBrush}"
                        BorderBrush="{DynamicResource BorderBrushLight}"
                        BorderThickness="0,1,1,0"
                        Visibility="{Binding ShowGroupsPanel, Converter={StaticResource BoolToVisibility}}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="34" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <TextBlock Text="Группы" Style="{StaticResource PanelHeaderTextStyle}" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,4,0">
                                <Button Style="{StaticResource IconButtonStyle}"
                                        Command="{Binding AddGroupCommand}"
                                        Content="&#xE710;"
                                        ToolTip="Добавить группу" />
                                <Button Style="{StaticResource IconButtonStyle}"
                                        Command="{Binding EditGroupCommand}"
                                        Content="&#xE70F;"
                                        ToolTip="Переименовать группу" />
                                <Button Style="{StaticResource IconButtonStyle}"
                                        Command="{Binding DeleteGroupCommand}"
                                        Content="&#xE74D;"
                                        ToolTip="Удалить группу" />
                            </StackPanel>
                        </Grid>

                        <ListBox Grid.Row="1"
                                 Style="{StaticResource SidebarListBoxStyle}"
                                 ItemsSource="{Binding Groups}"
                                 SelectedItem="{Binding SelectedGroup, Mode=TwoWay}"
                                 DisplayMemberPath="Title"
                                 Margin="4" />
                    </Grid>
                </Border>

                <!-- Поиск, фильтры и таблица -->
                <Grid Grid.Column="2" Margin="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="34" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" BorderBrush="{DynamicResource BorderBrushLight}" BorderThickness="0,1,0,1">
                        <TextBox Style="{StaticResource InputTextBoxStyle}"
                                 Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 BorderThickness="0"
                                 VerticalAlignment="Center"
                                 Padding="10,4" />
                    </Border>

                    <TextBlock Grid.Row="0"
                               Text="Поиск"
                               Margin="12,0,0,0"
                               VerticalAlignment="Center"
                               IsHitTestVisible="False"
                               Foreground="{DynamicResource MutedTextBrush}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SearchText}" Value="">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding SearchText}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <!-- Панель фильтров -->
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="10,8,10,4">
                        <Border Background="{DynamicResource SelectionBrush}"
                                BorderBrush="{DynamicResource SelectionBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="3"
                                Padding="8,3"
                                Margin="0,0,8,0"
                                Visibility="{Binding SelectedLabel, Converter={StaticResource NullToVisibility}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Метка: " Foreground="{DynamicResource MutedTextBrush}" />
                                <TextBlock Text="{Binding SelectedLabel.Name}" FontWeight="SemiBold" />
                            </StackPanel>
                        </Border>

                        <CheckBox x:Name="ShowPasswordsCheckBox"
                                  Content="Показать пароли"
                                  VerticalAlignment="Center"
                                  Margin="0,0,12,0"
                                  IsChecked="{Binding ShowPasswords, Mode=TwoWay}"
                                  Checked="ShowPasswords_Changed"
                                  Unchecked="ShowPasswords_Changed" />

                        <Button Style="{StaticResource SecondaryButtonStyle}"
                                Content="Сбросить фильтры"
                                Command="{Binding ResetFiltersCommand}"
                                Margin="0,0,8,0" />

                        <Button Style="{StaticResource SecondaryButtonStyle}"
                                Content="Импорт CSV/XLSX"
                                Command="{Binding ImportCommand}" />

                        <!-- Найденные на компьютере программы: яркая иконка — найдена, бледная — нет -->
                        <ItemsControl ItemsSource="{Binding ToolStatuses}"
                                      Margin="16,0,0,0"
                                      VerticalAlignment="Center">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Width="30"
                                            Height="30"
                                            Margin="2,0"
                                            Style="{StaticResource ToolIconButtonStyle}"
                                            Command="{Binding DataContext.LaunchToolCommand,
                                                              RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding Key}"
                                            ToolTip="{Binding ToolTipText}"
                                            ToolTipService.ShowDuration="20000"
                                            ToolTipService.ShowOnDisabled="True">
                                        <Grid Opacity="{Binding IconOpacity}">
                                            <Image Source="{Binding Icon}"
                                                   Width="22"
                                                   Height="22"
                                                   RenderOptions.BitmapScalingMode="HighQuality"
                                                   Visibility="{Binding HasIcon, Converter={StaticResource BoolToVisibility}}" />
                                            <Border BorderBrush="{DynamicResource BorderBrushLight}"
                                                    BorderThickness="1"
                                                    CornerRadius="4"
                                                    Width="22"
                                                    Height="22">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasIcon}" Value="False">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding FallbackText}"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource MutedTextBrush}" />
                                            </Border>
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- Заголовок текущей группы и кнопки работы с контактами -->
                    <Grid Grid.Row="2" Margin="10,4,10,6">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{Binding CurrentGroupTitle}"
                                       FontSize="17"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="{Binding StatusText}"
                                       Margin="14,0,0,0"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource MutedTextBrush}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Style="{StaticResource IconButtonStyle}"
                                    Command="{Binding AddContactCommand}"
                                    Content="&#xE710;"
                                    ToolTip="Добавить контакт" />
                            <Button Style="{StaticResource IconButtonStyle}"
                                    Command="{Binding EditContactCommand}"
                                    Content="&#xE70F;"
                                    ToolTip="Изменить контакт" />
                            <Button Style="{StaticResource IconButtonStyle}"
                                    Command="{Binding DeleteContactCommand}"
                                    Content="&#xE74D;"
                                    ToolTip="Удалить контакт" />
                        </StackPanel>
                    </Grid>

                    <DataGrid x:Name="ContactsGrid"
                              Grid.Row="3"
                              Margin="10,0,10,10"
                              Style="{StaticResource ContactsGridStyle}"
                              CellStyle="{StaticResource ContactsGridCellStyle}"
                              RowStyle="{StaticResource ContactsGridRowStyle}"
                              ColumnHeaderStyle="{StaticResource ContactsGridHeaderStyle}"
                              ItemsSource="{Binding ContactsView}"
                              SelectedItem="{Binding SelectedContact, Mode=TwoWay}"
                              MouseDoubleClick="ContactsGrid_MouseDoubleClick"
                              PreviewMouseRightButtonDown="ContactsGrid_PreviewMouseRightButtonDown"
                              ContextMenuOpening="ContactsGrid_ContextMenuOpening">
                        <DataGrid.ContextMenu>
                            <ContextMenu>
                                <!-- Пункты подменю (по программам) строятся при открытии меню -->
                                <MenuItem x:Name="ConnectMenuItem" Header="Подключиться">
                                    <MenuItem.Icon>
                                        <TextBlock Style="{StaticResource MenuGlyphStyle}" Text="&#xE703;" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="Изменить" Command="{Binding EditContactCommand}">
                                    <MenuItem.Icon>
                                        <TextBlock Style="{StaticResource MenuGlyphStyle}" Text="&#xE70F;" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <Separator />
                                <MenuItem Header="Удалить" Command="{Binding DeleteContactCommand}">
                                    <MenuItem.Icon>
                                        <TextBlock Style="{StaticResource MenuGlyphStyle}"
                                                   Text="&#xE74D;"
                                                   Foreground="{DynamicResource DangerBrush}" />
                                    </MenuItem.Icon>
                                </MenuItem>
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                        <DataGrid.Columns>
                            <DataGridTextColumn x:Name="NameColumn" Header="Имя" Binding="{Binding Name}" Width="180" />
                            <DataGridTextColumn x:Name="CommentColumn" Header="Комментарий" Binding="{Binding Comment}" Width="200" />
                            <DataGridTextColumn x:Name="AnyDeskColumn" Header="AnyDesk" Binding="{Binding AnyDesk}" Width="110" />
                            <DataGridTextColumn x:Name="RudesktopColumn" Header="Rudesktop" Binding="{Binding Rudesktop}" Width="110" />
                            <DataGridTextColumn x:Name="AssistantColumn" Header="Ассистент" Binding="{Binding Assistant}" Width="110" />
                            <DataGridTextColumn x:Name="AmmyyColumn" Header="AmmyyAdmin" Binding="{Binding Ammyy}" Width="110" />
                            <DataGridTextColumn x:Name="PasswordMaskedColumn" Header="Пароль" Binding="{Binding PasswordMasked}" Width="90" />
                            <DataGridTextColumn x:Name="PasswordPlainColumn" Header="Пароль" Binding="{Binding Password}" Width="90" Visibility="Collapsed" />
                            <DataGridTextColumn x:Name="RdpColumn" Header="RDP" Binding="{Binding Rdp}" Width="120" />
                            <DataGridTextColumn x:Name="RdpLoginColumn" Header="RDP Логин" Binding="{Binding RdpLogin}" Width="110" />
                            <DataGridTextColumn x:Name="RdpPasswordMaskedColumn" Header="RDP Пароль" Binding="{Binding RdpPasswordMasked}" Width="100" />
                            <DataGridTextColumn x:Name="RdpPasswordPlainColumn" Header="RDP Пароль" Binding="{Binding RdpPassword}" Width="100" Visibility="Collapsed" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
