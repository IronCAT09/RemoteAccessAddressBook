<Window x:Class="RemoteAccessAddressBook.Views.PassphraseWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Парольная фраза"
        Width="460"
        SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI"
        FontSize="13"
        Icon="/Assets/app.ico"
        Background="{DynamicResource WindowBackgroundBrush}">

    <StackPanel Margin="16">
        <TextBlock x:Name="MessageText" TextWrapping="Wrap" Margin="0,0,0,12" Foreground="{DynamicResource TextBrush}" />

        <TextBlock Text="Парольная фраза" Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,0,4" />
        <PasswordBox x:Name="FirstBox" PasswordChanged="Passphrase_Changed" />

        <StackPanel x:Name="ConfirmPanel" Visibility="Collapsed" Margin="0,10,0,0">
            <TextBlock Text="Ещё раз" Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,0,4" />
            <PasswordBox x:Name="SecondBox" PasswordChanged="Passphrase_Changed" />
        </StackPanel>

        <TextBlock x:Name="HintText"
                   Margin="0,8,0,0"
                   FontSize="12"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource MutedTextBrush}" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="OkButton"
                    Content="ОК"
                    Style="{StaticResource FlatButtonStyle}"
                    IsDefault="True"
                    Click="Ok_Click"
                    Margin="0,0,8,0" />
            <Button Content="Отмена"
                    Style="{StaticResource SecondaryButtonStyle}"
                    IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>
